# Copy this file to credentials/keystore.properties (gitignored).
# Never commit real passwords or the .jks keystore.
#
# storeFile must be an absolute path to the production keystore OUTSIDE git.
# Use forward slashes so Gradle accepts the path on Windows.
#
# Example (local machine):
#   storeFile=D:/secure/android-signing/hexonicaRuStore/hexonica-release.jks
#   storePassword=REPLACE_ME
#   keyAlias=hexonica
#   keyPassword=REPLACE_ME

storeFile=D:/secure/android-signing/hexonicaRuStore/hexonica-release.jks
storePassword=REPLACE_ME
keyAlias=hexonica
keyPassword=REPLACE_ME
